<div class="oa-calendar-container">
  <div class="oa-calendar-toolbar">
    <div class="oa-calendar-period-group">
      <button type="button" class="oa-calendar-date-picker-trigger" aria-haspopup="dialog" aria-expanded="false" title="{{t 'open_date_picker'}}" aria-label="{{t 'open_date_picker'}}"></button>
      <div class="oa-calendar-current-period">
        <h2>{{calendar.periodName}}</h2>
      </div>
    </div>
    
    <div class="oa-calendar-nav-container">
      <div class="oa-calendar-view-selector">
        <div class="oa-calendar-view-segmented" role="group" aria-label="{{t 'calendar_view_title'}}">
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "year"}}oa-active{{/equals}}" data-view-type="year" title="{{t 'year_view'}}" aria-label="{{t 'year_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "month"}}oa-active{{/equals}}" data-view-type="month" title="{{t 'month_view'}}" aria-label="{{t 'month_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "week"}}oa-active{{/equals}}" data-view-type="week" title="{{t 'week_view'}}" aria-label="{{t 'week_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "workweek"}}oa-active{{/equals}}" data-view-type="workweek" title="{{t 'workweek_view'}}" aria-label="{{t 'workweek_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "day"}}oa-active{{/equals}}" data-view-type="day" title="{{t 'day_view'}}" aria-label="{{t 'day_view'}}"></button>
        </div>
      </div>

      <div class="oa-calendar-navigation">
        <button class="oa-calendar-prev" aria-label="{{t 'previous'}}">
          <span class="icon">◀</span>
        </button>
        <button class="oa-calendar-today" aria-label="{{t 'today'}}">
          {{t 'today'}}
        </button>
        <button class="oa-calendar-next" aria-label="{{t 'next'}}">
          <span class="icon">▶</span>
        </button>
      </div>
    </div>
  </div>

  {{!-- Vista anual --}}
  {{#equals calendar.viewType "year"}}
  <div class="oa-calendar-year-view">
    <div class="oa-calendar-year-grid">
      {{#each calendar.months}}
        <div class="oa-calendar-year-month">
          <div class="oa-calendar-year-month-header">
            <h3>{{monthName}}</h3>
          </div>
          
          <div class="oa-calendar-year-month-weekdays">
            {{#each ../dayNames}}
              <div class="oa-calendar-year-weekday">{{this}}</div>
            {{/each}}
          </div>
          
          <div class="oa-calendar-year-month-grid">
            {{#each weeks}}
              <div class="oa-calendar-year-week">
                {{#each days}}
                  <div class="oa-calendar-year-day 
                      {{#if isCurrentMonth}}oa-current-month{{else}}oa-other-month{{/if}} 
                      {{#if isToday}}oa-year-today{{/if}}
                      {{#if isSelected}}oa-year-selected{{/if}}
                      {{#if hasTasksDue}}oa-has-tasks{{/if}}"
                      data-date="{{toISODate date}}"
                      data-task-count="{{taskCount}}">
                    <div class="oa-year-day-content">
                      <span class="oa-year-day-number {{#if hasTasksDue}}oa-day-has-tasks{{/if}}">
                        {{dayOfMonth}}
                      </span>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{/each}}
          </div>
        </div>
      {{/each}}
    </div>
  </div>
  {{/equals}}
</div>