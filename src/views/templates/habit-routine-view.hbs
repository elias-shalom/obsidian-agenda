{{!-- Habit Routine View Template (Phase 0 - Stub) --}}
<div class="oa-habit-toolbar">
  <div class="oa-habit-current">
    <h2>{{t viewLabelKey}}</h2>
    <div class="oa-habit-routine-date">
      <span>{{t "habit_today"}}: {{formatDate selectedDate}}</span>
    </div>
    <button id="oa-habit-new-btn" type="button" class="oa-habit-new-btn" aria-label="{{t 'habit_new_habit'}}" title="{{t 'habit_new_habit'}}">+</button>
    <button id="oa-habit-vacations-btn" type="button" class="oa-habit-vacations-btn" aria-label="{{t 'habit_vacations'}}" title="{{t 'habit_vacations'}}">🌴</button>
  </div>
  <div class="oa-habit-nav-container">
    <div class="oa-axis-chip oa-axis-chip--sort">
      <button type="button" id="oa-habit-routine-sort" class="oa-axis-chip__label" aria-haspopup="menu" aria-label="{{t 'habit_sort_label'}} {{sortLabel}}">{{t 'habit_sort_label'}} {{sortLabel}}</button>
    </div>
    <div class="oa-axis-chip oa-axis-chip--group">
      <button type="button" id="oa-habit-routine-group" class="oa-axis-chip__label" aria-haspopup="menu" aria-label="{{t 'habit_group_label'}} {{groupLabel}}">{{t 'habit_group_label'}} {{groupLabel}}</button>
    </div>
    <div class="oa-habit-routine-nav">
      <button class="oa-habit-routine-nav-btn" data-action="prev" aria-label="{{t 'previous'}}">
        <span class="icon">◀</span>
      </button>
      <button class="oa-habit-routine-today-btn" data-action="today">{{t "habit_today"}}</button>
      <button class="oa-habit-routine-nav-btn" data-action="next" aria-label="{{t 'next'}}">
        <span class="icon">▶</span>
      </button>
    </div>
    <div class="oa-calendar-view-segmented" role="group" aria-label="{{t 'habit_view_tab'}}">
      {{#if settings.showHabitDashboardTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "dashboard"}} oa-active{{/eq}}" data-habit-subtype="dashboard" title="{{t 'habit_dashboard_tab'}}" aria-label="{{t 'habit_dashboard_tab'}}"></button>{{/if}}
      {{#if settings.showHabitRoutineTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "routine"}} oa-active{{/eq}}" data-habit-subtype="routine" title="{{t 'habit_routine_tab'}}" aria-label="{{t 'habit_routine_tab'}}"></button>{{/if}}
      {{#if settings.showHabitWeeklyTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "weekly"}} oa-active{{/eq}}" data-habit-subtype="weekly" title="{{t 'habit_weekly_tab'}}" aria-label="{{t 'habit_weekly_tab'}}"></button>{{/if}}
      {{#if settings.showHabitGridTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "grid"}} oa-active{{/eq}}" data-habit-subtype="grid" title="{{t 'habit_grid_tab'}}" aria-label="{{t 'habit_grid_tab'}}"></button>{{/if}}
      {{#if settings.showHabitListTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "table"}} oa-active{{/eq}}" data-habit-subtype="table" title="{{t 'habit_list_tab'}}" aria-label="{{t 'habit_list_tab'}}"></button>{{/if}}
    </div>
  </div>
</div>

<div class="oa-habit-routine">
  {{#if hasHabits}}
  {{#each daytimes}}
    <div class="oa-habit-routine-section" data-group-key="{{@key}}">
      <button type="button" class="oa-habit-routine-section-header" aria-expanded="true">
        <span class="oa-habit-routine-section-caret" aria-hidden="true">▾</span>
        <div class="oa-habit-routine-section-title">
          {{#if this.color}}
            <div class="oa-habit-routine-section-color" style="background-color: {{this.color}}"></div>
          {{/if}}
          <span>{{this.label}}</span>
        </div>
        <div class="oa-habit-routine-section-progress">
          <div class="oa-habit-routine-progress-bar">
            <div class="oa-habit-routine-progress-fill" style="width: {{this.pct}}%"></div>
          </div>
          <span>{{this.pct}}%</span>
        </div>
      </button>
      <div class="oa-habit-routine-section-content">
        {{#each this.habits}}
        <div class="oa-habit-routine-habit">
          <button
            class="oa-habit-routine-checkbox {{#if this.ticked}}oa-habit-routine-checkbox--checked{{/if}}"
            data-habit-id="{{this.id}}"
            data-date="{{@root.selectedDate}}"
            aria-label="{{this.title}} {{t "habit_today"}}">
          </button>
          <div class="oa-habit-routine-habit-info">
            <div class="oa-habit-routine-habit-title" data-habit-id="{{this.id}}">{{this.title}}</div>
            <div class="oa-habit-routine-habit-meta">
              <span class="oa-habit-routine-priority-badge" data-priority="{{this.priority}}">{{this.priority}}</span>
              <span class="oa-habit-routine-time">{{this.time}}m</span>
              {{#unless (eq @root.groupBy "area")}}
                <span class="oa-habit-routine-area-tag" style="background-color: {{this.areaColor}}; color: {{this.areaTextColor}}">{{this.areaLabel}}</span>
              {{/unless}}
              {{#unless (eq @root.groupBy "daytime")}}
                <span class="oa-habit-routine-daytime-tag">{{this.daytimeLabel}}</span>
              {{/unless}}
            </div>
            {{#unless (eq @root.groupBy "area")}}
              {{#if @root.settings.showHabitSubAreaField}}
                {{#if this.subArea}}
                  <div class="oa-habit-routine-sub-area">{{this.subArea}}</div>
                {{/if}}
              {{/if}}
            {{/unless}}
          </div>
          <div class="oa-habit-routine-habit-actions">
            <button class="oa-habit-routine-action-btn" data-action="open-note" data-habit-id="{{this.id}}">{{t "open_file"}}</button>
            {{#if this.hasRelatedFile}}
              <button class="oa-habit-routine-action-btn" data-action="open-related" data-habit-id="{{this.id}}">{{t "habit_open_related_file"}}</button>
            {{/if}}
            <button class="oa-habit-routine-action-btn" data-action="edit-habit" data-habit-id="{{this.id}}">{{t "habit_edit_habit"}}</button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  {{/each}}
  {{else}}
    <div class="oa-habit-routine-empty">{{emptyMessage}}</div>
  {{/if}}

  <div class="oa-habit-routine-area-summary">
    {{#each areaStats}}
      <div class="oa-habit-routine-area-item">
        <div class="oa-habit-routine-area-color" style="background-color: {{this.color}}"></div>
        <span>{{this.label}}: {{this.pctWeighted}}% ({{this.pct}}%)</span>
      </div>
    {{/each}}
  </div>
</div>