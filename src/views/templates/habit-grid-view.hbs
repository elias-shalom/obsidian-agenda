<div class="oa-habit-toolbar">
  <div class="oa-habit-current">
    <h2>{{t viewLabelKey}}</h2>
    <span class="oa-habit-grid-range">{{windowLabel}}</span>
    <button id="oa-habit-new-btn" type="button" class="oa-habit-new-btn" aria-label="{{t 'habit_new_habit'}}" title="{{t 'habit_new_habit'}}">+</button>
    <button id="oa-habit-vacations-btn" type="button" class="oa-habit-vacations-btn" aria-label="{{t 'habit_vacations'}}" title="{{t 'habit_vacations'}}">🌴</button>
  </div>
  <div class="oa-habit-nav-container">
    <div class="oa-axis-chip oa-axis-chip--sort">
      <button type="button" id="oa-habit-grid-sort" class="oa-axis-chip__label" aria-haspopup="menu" aria-label="{{t 'habit_sort_label'}} {{sortLabel}}">{{t 'habit_sort_label'}} {{sortLabel}}</button>
    </div>
    <div class="oa-habit-grid-nav">
      <button class="oa-habit-grid-prev" aria-label="{{t 'previous'}}">
        <span class="icon">◀</span>
      </button>
      <button class="oa-habit-grid-next" aria-label="{{t 'next'}}">
        <span class="icon">▶</span>
      </button>
    </div>
    <div class="oa-calendar-view-segmented" role="group" aria-label="{{t 'habit_view_tab'}}">
      {{#if settings.showHabitDashboardTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "dashboard"}} oa-active{{/eq}}" data-habit-subtype="dashboard" title="{{t 'habit_dashboard_tab'}}" aria-label="{{t 'habit_dashboard_tab'}}"></button>{{/if}}
      {{#if settings.showHabitRoutineTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "routine"}} oa-active{{/eq}}" data-habit-subtype="routine" title="{{t 'habit_routine_tab'}}" aria-label="{{t 'habit_routine_tab'}}"></button>{{/if}}
      {{#if settings.showHabitWeeklyTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "weekly"}} oa-active{{/eq}}" data-habit-subtype="weekly" title="{{t 'habit_weekly_tab'}}" aria-label="{{t 'habit_weekly_tab'}}"></button>{{/if}}
      {{#if settings.showHabitGridTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "grid"}} oa-active{{/eq}}" data-habit-subtype="grid" title="{{t 'habit_grid_tab'}}" aria-label="{{t 'habit_grid_tab'}}"></button>{{/if}}
      {{#if settings.showHabitListTab}}<button type="button" class="oa-calendar-view-btn{{#eq viewSubtype "table"}} oa-active{{/eq}}" data-habit-subtype="table" title="{{t 'habit_list_tab'}}" aria-label="{{t 'habit_list_tab'}}"></button>{{/if}}
    </div>
  </div>
</div>

<div class="oa-habit-grid-scroll">
  <div class="oa-habit-grid" style="--date-columns: {{columns.length}}">
    <div class="oa-habit-grid-header">
      <div class="oa-habit-grid-col-header">{{t "habit_grid_title"}}</div>
      {{#each columns}}
        <div class="oa-habit-grid-col-header {{#if this.actual}}oa-habit-grid-col-header--today{{/if}}" title="{{this.label}}">
          <span class="oa-habit-grid-col-header-day">{{this.day}}</span>
        </div>
      {{/each}}
      <div class="oa-habit-grid-col-header">{{t "habit_streak"}}</div>
      <div class="oa-habit-grid-col-header">{{t "habit_pct_weighted"}}</div>
    </div>
    {{#each habits}}
      <div class="oa-habit-grid-row{{#if this.alt}} oa-habit-grid-row--alt{{/if}}"{{#if this.color}} style="--habit-color: {{this.color}}"{{/if}}>
        <div class="oa-habit-grid-name">
          {{#if this.color}}
            <div class="habit-color-indicator" style="background-color: {{this.color}}"></div>
          {{/if}}
          <a href="#" class="habit-title oa-habit-grid-name-link" data-habit-id="{{this.id}}" title="{{this.title}} — {{this.daytimeLabel}}" aria-label="{{this.title}}, {{this.daytimeLabel}}">{{this.title}}</a>
          {{#if this.showDaytimeLabel}}<span class="oa-habit-name-daytime">{{this.daytimeLabel}}</span>{{/if}}
        </div>
        {{#each this.cells}}
          <button
            class="oa-habit-grid-cell
              {{~#if this.ticked}} oa-habit-grid-cell--ticked{{/if}}
              {{~#if this.gap}} oa-habit-grid-cell--gap{{/if}}
              {{~#if this.deadline}} oa-habit-grid-cell--deadline{{/if}}
              {{~#unless this.scheduled}} oa-habit-grid-cell--unscheduled{{/unless}}
              {{~#if this.bridge}} oa-habit-grid-cell--bridge{{/if}}
              {{~#if this.unscheduledTicked}} oa-habit-grid-cell--unscheduled-ticked{{/if}}
              {{~#if this.vacation}} oa-habit-grid-cell--vacation{{/if}}
              {{~#if this.actual}} oa-habit-grid-cell--today{{/if}}
              {{~#if this.runSingle}} oa-habit-grid-cell--run-single{{/if}}
              {{~#if this.runStart}} oa-habit-grid-cell--run-start{{/if}}
              {{~#if this.runMiddle}} oa-habit-grid-cell--run-middle{{/if}}
              {{~#if this.runEnd}} oa-habit-grid-cell--run-end{{/if~}}"
            data-date="{{this.date}}"
            data-habit-id="{{../id}}"
            aria-label="{{../title}} {{../daytimeLabel}} {{this.date}}"
            {{#if this.deadline}}title="{{t 'habit_streak_deadline_tooltip'}}"{{else if this.vacationLabel}}title="{{this.vacationLabel}}"{{/if}}
            {{#unless this.markable}}disabled{{/unless}}>{{~#if this.runEnd}}{{#if (gt this.streakCount 1)}}<span class="oa-habit-grid-cell-count">{{this.streakCount}}</span>{{/if}}{{/if~}}</button>
        {{/each}}
        <div class="oa-habit-grid-streak">{{#if this.streak}}🔥 {{this.streak}}{{else}}–{{/if}}</div>
        <div class="oa-habit-grid-pct">{{this.pct}}%</div>
      </div>
    {{/each}}
  </div>
</div>
{{#unless habits.length}}
  <div class="oa-habit-routine-empty">{{emptyMessage}}</div>
{{/unless}}