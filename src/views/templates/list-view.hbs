{{!-- Plantillas internas: una tarea y un grupo (recursivo, para el agrupado por área y sub-área). --}}
{{#*inline "taskItem"}}
  <li class="oa-task-item" data-file-path="{{file.path}}" data-line-number="{{line.number}}" data-priority="{{state.priority}}">
    <div class="oa-task-priority">{{priorityIcon state.priority}}</div>
    <div class="oa-task-content">
      <div class="oa-task-description">
        {{section.desc}}
        {{#if date.start}}
          <span class="oa-task-date oa-task-date--start" title="{{t 'start_date'}}">🛫 {{formatDate date.start}}</span>
        {{/if}}
        {{#if date.scheduled}}
          <span class="oa-task-date oa-task-date--scheduled" title="{{t 'scheduled_date'}}">⏳ {{formatDate date.scheduled}}{{#if date.scheduledTime}} 🕐 {{date.scheduledTime}}{{/if}}</span>
        {{/if}}
        {{#if date.due}}
          <span class="oa-task-date oa-task-date--due" title="{{t 'due_date'}}">📅 {{formatDate date.due}}</span>
        {{/if}}
      </div>
      {{#if @root.showPath}}
        <div class="oa-task-metadata">
          <span class="oa-task-path">📄 {{file.path}}</span>
        </div>
      {{/if}}
    </div>
  </li>
{{/inline}}

{{#*inline "groupTemplate"}}
  <div class="oa-folder-group" data-folder="{{label}}" data-folder-path="{{storageKey}}" {{#if color}}data-group-color="{{color}}"{{/if}}>
    <h3 class="oa-folder-name">
      <span class="oa-folder-toggle" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </span>
      <span class="oa-folder-title">{{label}}</span>
      <span class="oa-task-count">({{count}})</span>
    </h3>
    <ul class="oa-folder-tasks">
      {{#each tasks}}
        {{> taskItem}}
      {{/each}}
    </ul>

    {{#if children.length}}
      <div class="oa-subfolders-container">
        {{#each children}}
          {{> groupTemplate}}
        {{/each}}
      </div>
    {{/if}}
  </div>
{{/inline}}

<div class="oa-list-toolbar"></div>

<div class="oa-list-body">
  {{#if tasks.length}}
    {{#if groups.length}}
      {{#each groups}}
        <div class="oa-folder-structure">
          {{> groupTemplate}}
        </div>
      {{/each}}
    {{else}}
      <div class="oa-folder-structure">
        <ul class="oa-folder-tasks">
          {{#each flatTasks}}
            {{> taskItem}}
          {{/each}}
        </ul>
      </div>
    {{/if}}
  {{else}}
    <p>{{#if vaultHasTasks}}{{t "no_tasks_match_filters"}}{{else}}{{t "no_tasks"}}{{/if}}</p>
  {{/if}}
</div>
