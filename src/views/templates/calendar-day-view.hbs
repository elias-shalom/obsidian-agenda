<div class="oa-calendar-container">
  <div class="oa-calendar-toolbar">
    <div class="oa-calendar-period-group">
      <button type="button" class="oa-calendar-date-picker-trigger" aria-haspopup="dialog" aria-expanded="false" title="{{t 'open_date_picker'}}" aria-label="{{t 'open_date_picker'}}"></button>
      <div class="oa-calendar-current-period">
        <h2>{{calendar.periodName}}</h2>
      </div>
    </div>
    
    <div class="oa-calendar-nav-container">
      <div class="oa-calendar-days-to-show-selector">
        <div class="oa-calendar-view-segmented" role="group" aria-label="{{t 'calendar_days_to_show_label'}}">
          <button type="button" class="oa-calendar-view-btn oa-calendar-days-to-show-btn {{#equals calendar.daysToShow 1}}oa-active{{/equals}}" data-days-to-show="1" title="{{t 'calendar_days_to_show_1'}}" aria-label="{{t 'calendar_days_to_show_1'}}">1</button>
          <button type="button" class="oa-calendar-view-btn oa-calendar-days-to-show-btn {{#equals calendar.daysToShow 3}}oa-active{{/equals}}" data-days-to-show="3" title="{{t 'calendar_days_to_show_3'}}" aria-label="{{t 'calendar_days_to_show_3'}}">3</button>
          <button type="button" class="oa-calendar-view-btn oa-calendar-days-to-show-btn {{#equals calendar.daysToShow 5}}oa-active{{/equals}}" data-days-to-show="5" title="{{t 'calendar_days_to_show_5'}}" aria-label="{{t 'calendar_days_to_show_5'}}">5</button>
        </div>
      </div>

      <div class="oa-calendar-view-selector">
        <div class="oa-calendar-view-segmented" role="group" aria-label="{{t 'calendar_view_title'}}">
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "year"}}oa-active{{/equals}}" data-view-type="year" title="{{t 'year_view'}}" aria-label="{{t 'year_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "month"}}oa-active{{/equals}}" data-view-type="month" title="{{t 'month_view'}}" aria-label="{{t 'month_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "week"}}oa-active{{/equals}}" data-view-type="week" title="{{t 'week_view'}}" aria-label="{{t 'week_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "workweek"}}oa-active{{/equals}}" data-view-type="workweek" title="{{t 'workweek_view'}}" aria-label="{{t 'workweek_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "list"}}oa-active{{/equals}}" data-view-type="list" title="{{t 'calendar_list_view'}}" aria-label="{{t 'calendar_list_view'}}"></button>
          <button type="button" class="oa-calendar-view-btn {{#equals calendar.viewType "day"}}oa-active{{/equals}}" data-view-type="day" title="{{t 'day_view'}}" aria-label="{{t 'day_view'}}"></button>
        </div>
      </div>
      
      <div class="oa-calendar-navigation">
        <button class="oa-calendar-prev" aria-label="{{t 'previous'}}">
          <span class="icon">◀</span>
        </button>
        <button class="oa-calendar-today" aria-label="{{t 'today'}}">
          {{t 'today'}}
        </button>
        <button class="oa-calendar-next" aria-label="{{t 'next'}}">
          <span class="icon">▶</span>
        </button>
      </div>
    </div>
  </div>
  {{!-- Vista diaria --}}
  {{#equals calendar.viewType "day"}}
  <div class="oa-calendar-day-view">
    <div class="oa-calendar-day-container">
      <div class="oa-calendar-day-main-view">
        <div class="oa-calendar-day-header">
          <div class="oa-calendar-hour-label-spacer"></div>
          {{#each calendar.columns}}
            <div class="oa-calendar-day-column-header {{#if isToday}}oa-calendar-today{{/if}} {{#if isReferenceDay}}oa-calendar-selected{{/if}}" data-date="{{dateIso}}">
              <div class="oa-calendar-day-name">{{dayName}}</div>
              <div class="oa-calendar-date">{{dayOfMonth}}</div>
            </div>
          {{/each}}
        </div>
        <div class="oa-calendar-day-body">
          <div class="oa-calendar-allday oa-expanded">
            <button type="button" class="oa-calendar-allday-toggle" aria-expanded="true">
              <span class="oa-calendar-allday-caret">▸</span>
              {{t "calendar_all_day"}}
            </button>
            <div class="oa-calendar-allday-columns">
              <div class="oa-calendar-hour-label-spacer"></div>
              {{#each calendar.columns}}
                <div class="oa-calendar-allday-content" data-date="{{dateIso}}">
                  {{#if allDayDue.length}}
                    <div class="oa-calendar-allday-row">
                      {{#each allDayDue}}
                        <div class="oa-calendar-task oa-calendar-task--due {{#if (isTaskDone state.status)}}oa-calendar-task--done{{/if}}"
                            data-file-path="{{file.path}}"
                            data-line-number="{{line.number}}"
                            data-tooltip="{{section.desc}}">
                          <span class="oa-calendar-task-status-icon">{{state.emoji}}</span>
                          <span class="oa-task-title">{{section.desc}}</span>
                        </div>
                      {{/each}}
                    </div>
                  {{/if}}
                  {{#if allDayStart.length}}
                    <div class="oa-calendar-allday-row">
                      {{#each allDayStart}}
                        <div class="oa-calendar-task oa-calendar-task--start {{#if (isTaskDone state.status)}}oa-calendar-task--done{{/if}}"
                            data-file-path="{{file.path}}"
                            data-line-number="{{line.number}}"
                            data-tooltip="{{section.desc}}">
                          <span class="oa-calendar-task-status-icon">{{state.emoji}}</span>
                          <span class="oa-task-title">{{section.desc}}</span>
                        </div>
                      {{/each}}
                    </div>
                  {{/if}}
                  {{#if allDayScheduled.length}}
                    <div class="oa-calendar-allday-row">
                      {{#each allDayScheduled}}
                        <div class="oa-calendar-task oa-calendar-task--scheduled {{#if (isTaskDone state.status)}}oa-calendar-task--done{{/if}}"
                            draggable="true"
                            data-file-path="{{file.path}}"
                            data-line-number="{{line.number}}"
                            data-date-type="scheduled"
                            data-tooltip="{{section.desc}}">
                          <span class="oa-calendar-task-status-icon">{{state.emoji}}</span>
                          <span class="oa-task-title">{{section.desc}}</span>
                        </div>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          </div>

          <div class="oa-calendar-day-hours">
            {{#each calendar.hourRows}}
              <div class="oa-calendar-hour-row">
                <div class="oa-calendar-hour-label">{{formattedHour}}</div>
                {{#each columns}}
                <div class="oa-calendar-hour-slot" data-hour="{{../hour}}" data-date="{{dateIso}}">
                  {{#if hasDurationSegments}}
                  <div class="oa-calendar-duration-track">
                    <div class="oa-calendar-half-slot oa-calendar-half-slot--upper">
                      {{#each upperHalfSegments}}
                        <div class="oa-calendar-task oa-calendar-task--scheduled oa-calendar-task--duration oa-calendar-duration-segment--{{segmentRole}} {{#if (isTaskDone state.status)}}oa-calendar-task--done{{/if}}"
                            draggable="true"
                            data-file-path="{{file.path}}"
                            data-line-number="{{line.number}}"
                            data-date-type="scheduled"
                            data-scheduled-time="{{date.scheduledTime}}"
                            data-tooltip="{{section.desc}}"
                            style="left: {{laneLeftPercent}}%; width: {{laneWidthPercent}}%;">
                          {{#equals segmentRole "half"}}<span class="oa-calendar-task-time">{{date.scheduledTime}}</span>{{/equals}}
                          {{#equals segmentRole "start"}}<span class="oa-calendar-task-time">{{date.scheduledTime}}</span>{{/equals}}
                          <span class="oa-calendar-task-status-icon">{{state.emoji}}</span>
                          <span class="oa-task-title">{{section.desc}}</span>
                          {{#if date.scheduledDuration}}<span class="oa-calendar-task-duration">{{date.scheduledDuration}}m</span>{{/if}}
                          {{#equals segmentRole "half"}}<div class="oa-calendar-resize-handle" draggable="false" data-file-path="{{file.path}}" data-line-number="{{line.number}}" data-current-duration="{{date.scheduledDuration}}"></div>{{/equals}}
                          {{#equals segmentRole "end"}}<div class="oa-calendar-resize-handle" draggable="false" data-file-path="{{file.path}}" data-line-number="{{line.number}}" data-current-duration="{{date.scheduledDuration}}"></div>{{/equals}}
                        </div>
                      {{/each}}
                    </div>
                    <div class="oa-calendar-half-slot oa-calendar-half-slot--lower">
                      {{#each lowerHalfSegments}}
                        <div class="oa-calendar-task oa-calendar-task--scheduled oa-calendar-task--duration oa-calendar-duration-segment--{{segmentRole}} {{#if (isTaskDone state.status)}}oa-calendar-task--done{{/if}}"
                            draggable="true"
                            data-file-path="{{file.path}}"
                            data-line-number="{{line.number}}"
                            data-date-type="scheduled"
                            data-scheduled-time="{{date.scheduledTime}}"
                            data-tooltip="{{section.desc}}"
                            style="left: {{laneLeftPercent}}%; width: {{laneWidthPercent}}%;">
                          {{#equals segmentRole "half"}}<span class="oa-calendar-task-time">{{date.scheduledTime}}</span>{{/equals}}
                          {{#equals segmentRole "start"}}<span class="oa-calendar-task-time">{{date.scheduledTime}}</span>{{/equals}}
                          <span class="oa-calendar-task-status-icon">{{state.emoji}}</span>
                          <span class="oa-task-title">{{section.desc}}</span>
                          {{#if date.scheduledDuration}}<span class="oa-calendar-task-duration">{{date.scheduledDuration}}m</span>{{/if}}
                          {{#equals segmentRole "half"}}<div class="oa-calendar-resize-handle" draggable="false" data-file-path="{{file.path}}" data-line-number="{{line.number}}" data-current-duration="{{date.scheduledDuration}}"></div>{{/equals}}
                          {{#equals segmentRole "end"}}<div class="oa-calendar-resize-handle" draggable="false" data-file-path="{{file.path}}" data-line-number="{{line.number}}" data-current-duration="{{date.scheduledDuration}}"></div>{{/equals}}
                        </div>
                      {{/each}}
                    </div>
                  </div>
                  {{/if}}
                </div>
                {{/each}}
              </div>
            {{/each}}
          </div>
        </div>
      </div>

      <button type="button" class="oa-calendar-sidebar-toggle" aria-expanded="{{#unless calendar.sidebarCollapsed}}true{{else}}false{{/unless}}" title="{{t 'toggle_sidebar'}}" aria-label="{{t 'toggle_sidebar'}}"></button>

      <div class="oa-calendar-mini-sidebar {{#if calendar.sidebarCollapsed}}oa-calendar-mini-sidebar--collapsed{{/if}}">
        <div class="oa-date-picker-docked"></div>
      </div>
    </div>
  </div>
  {{/equals}}
</div>


