{{!-- src/modals/templates/create-task-modal.hbs --}}
<div class="oa-task-modal__wrapper">
  <!-- Encabezado principal -->
  <div class="oa-task-modal__header">
    <h1 class="oa-task-modal__title">{{headerTitle}}</h1>
  </div>

  <!-- Formulario -->
  <form id="oa-task-form" class="oa-task-modal__form">    
    <!-- Campo de Título -->
    <div class="oa-form-group">
      <input 
        id="oa-task-title" 
        type="text" 
        class="oa-form-input"
        value="{{taskTitle}}"
        placeholder="{{t "task_description_placeholder"}}"
        required 
      />
    </div>

        <!-- Campo de Archivo destino -->
    <div class="oa-form-group oa-file-picker-group">
      <input 
        id="oa-task-file" 
        type="text" 
        class="oa-form-input"
        value="{{filePathValue}}" 
        placeholder="{{t "task_file_placeholder"}}"
        autocomplete="off"
        {{#if isEdit}}readonly{{/if}}
      />
      <ul id="oa-file-suggestions" class="oa-file-suggestions oa-hidden"></ul>
      <span id="oa-file-hint" class="oa-file-hint"></span>
    </div>

        <!-- Campo de Prioridad -->
    <div class="oa-form-group">
      <div id="oa-priority-group" class="oa-priority-segmented" role="radiogroup" aria-label="{{t "task_priority"}}" data-selected="{{priorityValue}}">
        <button type="button" class="oa-priority-pill" data-priority="⏬" title="{{t "lowest_priority"}}">⏬</button>
        <button type="button" class="oa-priority-pill" data-priority="🔽" title="{{t "low_priority"}}">🔽</button>
        <button type="button" class="oa-priority-pill" data-priority="" title="{{t "normal_priority"}}">▶️</button>
        <button type="button" class="oa-priority-pill" data-priority="🔼" title="{{t "medium_priority"}}">🔼</button>
        <button type="button" class="oa-priority-pill" data-priority="⏫" title="{{t "high_priority"}}">⏫</button>
        <button type="button" class="oa-priority-pill" data-priority="🔺" title="{{t "highest_priority"}}">🔺</button>
      </div>
    </div>

    <!-- Campo de Estado (v1.1.10, Manejo de estatus): mismo patrón visual que Prioridad -->
    <div class="oa-form-group">
      <div id="oa-status-group" class="oa-priority-segmented" role="radiogroup" aria-label="{{t "task_status"}}" data-selected="{{statusValue}}">
        <button type="button" class="oa-priority-pill" data-status=" " title="{{t "status_todo"}}">⭕</button>
        <button type="button" class="oa-priority-pill" data-status="/" title="{{t "status_in_progress"}}">🛠️</button>
        <button type="button" class="oa-priority-pill" data-status="?" title="{{t "status_on_hold"}}">⏸️</button>
        <button type="button" class="oa-priority-pill" data-status="x" title="{{t "status_done"}}">✅</button>
        <button type="button" class="oa-priority-pill" data-status="-" title="{{t "status_cancelled"}}">❌</button>
        <button type="button" class="oa-priority-pill" data-status="~" title="{{t "status_non_task"}}">🗑️</button>
      </div>
    </div>

    <!-- Campo de Fecha programada + hora + duración, todo en el mismo renglón (v1.1.4: scheduled es el campo de fecha por defecto, en lugar de due) -->
    <div class="oa-form-group oa-date-picker-group">
      <button 
        type="button" 
        id="oa-scheduled-trigger" 
        class="oa-date-trigger"
        title="{{t "scheduled_date"}}"
      >
        ⏳
      </button>
      <span id="oa-scheduled-label" class="oa-date-label">{{scheduledLabelValue}}</span>
      <input 
        id="oa-task-scheduled" 
        type="hidden" 
        value="{{scheduledDateValue}}" 
      />

      <button type="button" id="oa-scheduled-time-trigger" class="oa-date-trigger" title="{{t "task_field_menu_set_scheduled_time"}}">🕐</button>
      <span id="oa-scheduled-time-label" class="oa-date-label">{{scheduledTimeLabelValue}}</span>
      <input id="oa-task-scheduled-time" type="hidden" value="{{scheduledTimeValue}}" />

      <button type="button" id="oa-scheduled-duration-trigger" class="oa-date-trigger" title="{{t "task_field_menu_set_duration"}}">⏱️</button>
      <span id="oa-scheduled-duration-label" class="oa-date-label">{{scheduledDurationLabelValue}}</span>
      <input id="oa-task-scheduled-duration" type="hidden" value="{{scheduledDurationValue}}" />
    </div>

    <!-- Toggle de opciones avanzadas (v1.1.4, Fase E) -->
    <button type="button" id="oa-advanced-toggle" class="oa-advanced-toggle" aria-expanded="false">
      <span class="oa-advanced-toggle-caret">▾</span>
      <span id="oa-advanced-toggle-label">{{t "task_advanced_toggle_show"}}</span>
    </button>

    <div id="oa-advanced-fields" class="oa-advanced-fields">
      <!-- Fecha de vencimiento (movida aquí: scheduled es ahora el campo de fecha por defecto) -->
      <div class="oa-form-group oa-date-picker-group">
        <button type="button" id="oa-date-trigger" class="oa-date-trigger" title="{{t "due_date"}}">📅</button>
        <span id="oa-date-label" class="oa-date-label">{{dueLabelValue}}</span>
        <input id="oa-task-due" type="hidden" value="{{dueDateValue}}" />
      </div>

      <!-- Fecha de inicio -->
      <div class="oa-form-group oa-date-picker-group">
        <button type="button" id="oa-start-trigger" class="oa-date-trigger" title="{{t "start_date"}}">🛫</button>
        <span id="oa-start-label" class="oa-date-label">{{startLabelValue}}</span>
        <input id="oa-task-start" type="hidden" value="{{startDateValue}}" />
      </div>

      <!-- Recurrencia -->
      <div class="oa-form-group oa-recurrence-group">
        <label class="oa-form-label" for="oa-task-recurrence">{{t "task_recurrence"}}</label>
        <input id="oa-task-recurrence" type="text" class="oa-form-input" value="{{recurrenceValue}}" placeholder="{{t "task_recurrence_placeholder"}}" autocomplete="off" />
        <ul id="oa-recurrence-suggestions" class="oa-file-suggestions oa-hidden"></ul>
      </div>

      <!-- Dependencias + Id personalizado, en el mismo renglón -->
      <div class="oa-form-row">
        <div class="oa-form-group">
          <label class="oa-form-label" for="oa-task-depends">{{t "task_dependencies"}}</label>
          <input id="oa-task-depends" type="text" class="oa-form-input" value="{{dependsValue}}" placeholder="{{t "task_dependencies_placeholder"}}" />
        </div>

        <div class="oa-form-group">
          <label class="oa-form-label" for="oa-task-id">{{t "task_id"}}</label>
          <input id="oa-task-id" type="text" class="oa-form-input" value="{{idValue}}" placeholder="{{t "task_id_placeholder"}}" />
        </div>
      </div>

      <!-- Al completarse -->
      <div class="oa-form-group">
        <label class="oa-form-label" for="oa-task-oncompletion">{{t "task_on_completion"}}</label>
        <select id="oa-task-oncompletion" class="oa-form-select" data-value="{{onCompletionValue}}">
          <option value="">{{t "none"}}</option>
          <option value="keep">{{t "task_on_completion_keep"}}</option>
          <option value="delete">{{t "task_on_completion_delete"}}</option>
        </select>
      </div>
    </div>


    <!-- Botones de acción -->
    <div class="oa-task-modal__actions">
      <button type="submit" class="oa-btn oa-btn--primary">
        {{t "save"}}
      </button>
      <button type="button" id="oa-task-cancel" class="oa-btn oa-btn--secondary">
        {{t "cancel"}}
      </button>
    </div>
  </form>
</div>