{{!-- Habit Routine View Template (Phase 0 - Stub) --}}
<div class="oa-habit-toolbar">
  <div class="oa-habit-current">
    <h2>{{t viewLabelKey}}</h2>
    <div class="oa-habit-routine-date">
      <span>{{t "habit_today"}}: {{formatDate selectedDate}}</span>
    </div>
    <button id="oa-habit-new-btn" type="button" class="oa-habit-new-btn" aria-label="{{t 'habit_new_habit'}}" title="{{t 'habit_new_habit'}}">+</button>
  </div>
  <div class="oa-habit-nav-container">
    <div class="oa-habit-view-selector">
      <select id="oa-habit-view-dropdown" class="oa-habit-view-dropdown">
        {{#if settings.showHabitGridTab}}<option value="grid" {{#eq viewSubtype "grid"}}selected{{/eq}}>{{t "habit_grid_tab"}}</option>{{/if}}
        {{#if settings.showHabitDashboardTab}}<option value="dashboard" {{#eq viewSubtype "dashboard"}}selected{{/eq}}>{{t "habit_dashboard_tab"}}</option>{{/if}}
        {{#if settings.showHabitRoutineTab}}<option value="routine" {{#eq viewSubtype "routine"}}selected{{/eq}}>{{t "habit_routine_tab"}}</option>{{/if}}
        {{#if settings.showHabitWeeklyTab}}<option value="weekly" {{#eq viewSubtype "weekly"}}selected{{/eq}}>{{t "habit_weekly_tab"}}</option>{{/if}}
        {{#if settings.showHabitListTab}}<option value="table" {{#eq viewSubtype "table"}}selected{{/eq}}>{{t "habit_list_tab"}}</option>{{/if}}
      </select>
    </div>
    <div class="oa-habit-view-selector">
      <select id="oa-habit-routine-sort" class="oa-habit-view-dropdown">
        <option value="alphabetical" {{#eq sortBy "alphabetical"}}selected{{/eq}}>{{t "habit_sort_alphabetical"}}</option>
        <option value="area" {{#eq sortBy "area"}}selected{{/eq}}>{{t "habit_sort_area"}}</option>
        <option value="daytime" {{#eq sortBy "daytime"}}selected{{/eq}}>{{t "habit_sort_daytime"}}</option>
        <option value="priority" {{#eq sortBy "priority"}}selected{{/eq}}>{{t "habit_sort_priority"}}</option>
        <option value="streak" {{#eq sortBy "streak"}}selected{{/eq}}>{{t "habit_sort_streak"}}</option>
        <option value="pct" {{#eq sortBy "pct"}}selected{{/eq}}>{{t "habit_sort_pct"}}</option>
      </select>
    </div>
    <div class="oa-habit-view-selector">
      <select id="oa-habit-routine-group" class="oa-habit-view-dropdown">
        <option value="daytime" {{#eq groupBy "daytime"}}selected{{/eq}}>{{t "habit_sort_daytime"}}</option>
        <option value="area" {{#eq groupBy "area"}}selected{{/eq}}>{{t "habit_sort_area"}}</option>
      </select>
    </div>
    <div class="oa-habit-routine-nav">
      <button class="oa-habit-routine-nav-btn" data-action="prev">{{t "previous"}}</button>
      <button class="oa-habit-routine-today-btn" data-action="today">{{t "habit_today"}}</button>
      <button class="oa-habit-routine-nav-btn" data-action="next">{{t "next"}}</button>
    </div>
  </div>
</div>

<div class="oa-habit-routine">
  {{#if hasHabits}}
  {{#each daytimes}}
    <div class="oa-habit-routine-section">
      <div class="oa-habit-routine-section-header">
        <div class="oa-habit-routine-section-title">
          {{#if this.color}}
            <div class="oa-habit-routine-section-color" style="background-color: {{this.color}}"></div>
          {{/if}}
          <span>{{this.label}}</span>
        </div>
        <div class="oa-habit-routine-section-progress">
          <div class="oa-habit-routine-progress-bar">
            <div class="oa-habit-routine-progress-fill" style="width: {{this.pct}}%"></div>
          </div>
          <span>{{this.pct}}%</span>
        </div>
      </div>
      {{#each this.habits}}
        <div class="oa-habit-routine-habit">
          <button
            class="oa-habit-routine-checkbox {{#if this.ticked}}oa-habit-routine-checkbox--checked{{/if}}"
            data-habit-id="{{this.id}}"
            data-date="{{@root.selectedDate}}"
            aria-label="{{this.title}} {{t "habit_today"}}">
          </button>
          <div class="oa-habit-routine-habit-info">
            <div class="oa-habit-routine-habit-title">{{this.title}}</div>
            <div class="oa-habit-routine-habit-meta">
              <span class="oa-habit-routine-priority-badge" data-priority="{{this.priority}}">{{this.priority}}</span>
              <span class="oa-habit-routine-time">{{this.time}}m</span>
              {{#unless (eq @root.groupBy "area")}}
                <span class="oa-habit-routine-area-tag" style="background-color: {{this.areaColor}}; color: {{this.areaTextColor}}">{{this.areaLabel}}</span>
              {{/unless}}
              {{#unless (eq @root.groupBy "daytime")}}
                <span class="oa-habit-routine-daytime-tag">{{this.daytimeLabel}}</span>
              {{/unless}}
            </div>
          </div>
          <div class="oa-habit-routine-habit-actions">
            <button class="oa-habit-routine-action-btn" data-action="open-note" data-habit-id="{{this.id}}">{{t "edit_task"}}</button>
          </div>
        </div>
      {{/each}}
    </div>
  {{/each}}
  {{else}}
    <div class="oa-habit-routine-empty">{{t "habit_no_habits"}}</div>
  {{/if}}

  <div class="oa-habit-routine-area-summary">
    {{#each areaStats}}
      <div class="oa-habit-routine-area-item">
        <div class="oa-habit-routine-area-color" style="background-color: {{this.color}}"></div>
        <span>{{this.label}}: {{this.pctWeighted}}% ({{this.pct}}%)</span>
      </div>
    {{/each}}
  </div>
</div>